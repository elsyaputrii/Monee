# ===== Server =====
NODE_ENV=development
PORT=5000

# ===== Database (MySQL) =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=monee_db

# ===== Auth (JWT) =====
# Generate secret acak lewat terminal:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=isi_dengan_string_acak_minimal_32_karakter
JWT_EXPIRES_IN=7d

# ===== Security =====
BCRYPT_SALT_ROUNDS=10

# ===== CORS (alamat frontend Next.js, pisahkan dengan koma jika lebih dari satu) =====
CORS_ORIGIN=http://localhost:3000

# ===== Cookie login (httpOnly) =====
COOKIE_NAME=monee_token
# production (HTTPS): COOKIE_SECURE=true
COOKIE_SECURE=false
# lax = frontend & backend satu site (localhost). Jika beda domain di production: none (wajib COOKIE_SECURE=true)
COOKIE_SAMESITE=lax

# ===== Zona waktu untuk menentukan "bulan ini" =====
APP_TIMEZONE=Asia/Jakarta
